<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>NCronJob.Dashboard</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <PackageId>NCronJob.Dashboard</PackageId>
    <Title>NCronJob Dashboard</Title>
    <Description>A self-hosted monitoring and control dashboard for NCronJob.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/NCronJob-Dev/NCronJob</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/NCronJob-Dev/NCronJob</PackageProjectUrl>
    <PackageTags>ncronjob;dashboard;monitoring;scheduler;blazor</PackageTags>
    <Authors>Steven Giesel</Authors>
    <Company>Giesel Engineering</Company>
    <Copyright>Steven Giesel</Copyright>
    <Product>NCronJob.Dashboard</Product>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>logo_small.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/NCronJob-Dev/NCronJob/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Label="Build information">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OutputType>Library</OutputType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\NCronJob\NCronJob.csproj" Version="[$(PackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="dashboard.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\assets\logo_small.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="PinNCronJobPackageDependency" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" Condition="'%(_ProjectReferencesWithVersions.Filename)' == 'NCronJob'">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
